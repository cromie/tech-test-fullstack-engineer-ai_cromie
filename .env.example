# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional override
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional; only needed for user-level keys (sk-ant-usr-…) that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Optional; chat requests per minute per client (default 20)
CHAT_RATE_LIMIT_PER_MIN=
# Optional; defaults to ./data/games.db
DATABASE_PATH=
