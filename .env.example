# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional override
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional; only needed for user-level keys (sk-ant-usr-…) that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Optional; chat requests per minute (default 20). Without TRUST_PROXY all clients share one bucket.
CHAT_RATE_LIMIT_PER_MIN=
# Only set to true behind a reverse proxy that overwrites X-Forwarded-For; enables per-client limits
TRUST_PROXY=
# Optional; defaults to ./data/games.db
DATABASE_PATH=
